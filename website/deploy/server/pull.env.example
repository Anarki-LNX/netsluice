# /etc/netsluice-web/pull.env  (owner root, mode 600; never in git)
# Fine-grained GitHub token: Resource owner Anarki-LNX, Repository access "Public repositories
# (read-only)", no further permissions, expiry 1 year. Used only to download CI artifacts.
GITHUB_TOKEN=
# Optional (defaults shown):
# NSW_REPO=Anarki-LNX/netsluice
# NSW_WORKFLOW=website.yml
# NSW_ARTIFACT=netsluice-website-site
# NSW_DIR=/opt/netsluice-web
# NSW_KEEP=5
# NSW_HEALTH_URL=https://netsluice.loopout.tech/build.json   (empty: switch without checking)
