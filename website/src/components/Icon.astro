---
// Line icons in one weight (Feather-like, drawn for this site). Always decorative:
// the text next to an icon carries the meaning.
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-left'
  | 'github'
  | 'heart'
  | 'copy'
  | 'check'
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'chevron-left'
  | 'chevron-right'
  | 'filter'
  | 'activity'
  | 'devices'
  | 'globe'
  | 'clock'
  | 'settings'
  | 'refresh'
  | 'hard-drive'
  | 'lock'
  | 'languages'
  | 'shield'
  | 'download'
  | 'book'
  | 'info'
  | 'alert'
  | 'x-octagon'
  | 'cpu'
  | 'play'
  | 'code'
  | 'expand';

interface Props {
  name: IconName;
  size?: number | undefined;
  class?: string | undefined;
}
const { name, size = 18, class: cls } = Astro.props;

const paths: Record<IconName, string> = {
