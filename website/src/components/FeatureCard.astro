---
import Icon, { type IconName } from './Icon.astro';

// A card in the 3×2 grid (Parseable reference), with the loopout numbering.
interface Props {
  num?: string | undefined;
  icon?: IconName | undefined;
  title: string;
  text?: string | undefined;
  href?: string | undefined;
  linkText?: string | undefined;
  links?: { href: string; text: string }[];
  tone?: 'in' | 'gate' | 'ok' | 'water' | undefined;
  headingLevel?: 2 | 3 | undefined;
}
const { num, icon, title, text, href, linkText, links = [], tone = 'water', headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
---

<article class:list={['fc', `fc--${tone}`]} data-reveal>
  <div class="fc__top">
    {icon && (
      <span class="fc__icon">
        <Icon name={icon} size={20} />
      </span>
    )}
    {num && <span class="label fc__num">{num}</span>}
  </div>
  <H class="fc__title">
    {href && !links.length ? (
      <a class="fc__link" href={href}>
        {title}
      </a>
    ) : (
      title
    )}
  </H>
  {text && <p class="fc__text">{text}</p>}
  <slot />
  {links.length > 0 && (
    <ul role="list" class="fc__links">
      {links.map((l) => (
        <li>
          <a href={l.href}>
            <Icon name="arrow-right" size={15} />
            {l.text}
          </a>
        </li>
      ))}
    </ul>
  )}
  {href && !links.length && linkText && (
    <span class="fc__more" aria-hidden="true">
      {linkText} <Icon name="arrow-right" size={15} />
    </span>
  )}
</article>

<style>
  .fc {
    --tone: var(--water);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--tone) 7%, transparent), transparent 55%),
      linear-gradient(to bottom, rgb(255 255 255 / 0.025), rgb(255 255 255 / 0.01));
    box-shadow: var(--shadow-1);
    transition:
      border-color var(--t-med),
      transform var(--t-med) var(--ease-out),
      background-color var(--t-med);
  }
  .fc--in {
    --tone: var(--in);
  }
  .fc--gate {
    --tone: var(--gate);
  }
  .fc--ok {
    --tone: var(--ok);
  }
  .fc:hover {
    border-color: color-mix(in srgb, var(--tone) 35%, transparent);
  }
  .fc:has(.fc__link):hover {
    transform: translateY(-2px);
  }
  .fc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-2);
  }
  .fc__icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--tone) 35%, transparent);
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--tone) 10%, transparent);
    color: var(--tone);
  }
  .fc__num {
    color: var(--faint);
  }
  .fc__title {
    color: var(--text);
  }
  .fc__link {
    color: inherit;
    text-decoration: none;
  }
  /* the whole card is the link target */
  .fc__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .fc__link:focus-visible {
    outline: none;
  }
  .fc:has(.fc__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .fc__text {
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .fc__links {
    display: grid;
    gap: 0.1rem;
    margin-top: auto;
    padding-top: var(--s-2);
  }
  .fc__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 32px;
    font-size: var(--fs-small);
    text-decoration: none;
  }
  .fc__links a:hover {
    text-decoration: underline;
  }
  .fc__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--s-2);
    color: var(--in-ink);
    font-size: var(--fs-small);
  }
</style>
