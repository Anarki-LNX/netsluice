---
import { type Locale, t } from '~/i18n';

// How it works, as one drawing: devices → DNS :53 → the filter engine (AdGuard Home)
// inside the sluice → the internet. Stopped lookups end at the gate. Everything
// in the dashed frame stays on the device. Labels come from the page copy.
export interface DiagramLabels {
  title: string;
  desc: string;
  devices: string;
  dns: string;
  engine: string;
  sluice: string;
  internet: string;
  passed: string;
  stopped: string;
  onDevice: string;
}
interface Props {
  locale: Locale;
  /** defaults to the interface strings in src/i18n */
  labels?: DiagramLabels | undefined;
  /** unique per page if the diagram appears twice */
  id?: string | undefined;
}
const { locale, id = 'sd' } = Astro.props;
const tr = t(locale);
const labels: DiagramLabels = Astro.props.labels ?? {
  title: tr('diagram.title'),
  desc: tr('diagram.desc'),
  devices: tr('diagram.devices'),
  dns: tr('diagram.dns'),
  engine: tr('diagram.engine'),
  sluice: tr('diagram.sluice'),
  internet: tr('diagram.internet'),
  passed: tr('diagram.passed'),
  stopped: tr('diagram.stopped'),
  onDevice: tr('diagram.onDevice'),
};
---

<figure class="sd" data-reveal>
  <svg
    class="sd__svg sd__svg--wide"
    viewBox="0 0 1100 420"
    role="img"
    aria-labelledby={`${id}-t ${id}-d`}
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={`${id}-t`}>{labels.title}</title>
    <desc id={`${id}-d`}>{labels.desc}</desc>
    <defs>
      <linearGradient id={`${id}-in`} x1="0" x2="1">
        <stop offset="0" stop-color="#4EA8FF" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#4EA8FF"></stop>
      </linearGradient>
      <linearGradient id={`${id}-out`} x1="0" x2="1">
        <stop offset="0" stop-color="#5CE39A"></stop>
        <stop offset="1" stop-color="#5CE39A" stop-opacity="0.2"></stop>
      </linearGradient>
      <radialGradient id={`${id}-glow`}>
        <stop offset="0" stop-color="#F5C451" stop-opacity="0.22"></stop>
        <stop offset="1" stop-color="#F5C451" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <!-- the device frame: everything inside stays on the device -->
    <rect
      x="300"
      y="40"
      width="520"
      height="340"
      rx="28"
      fill="rgba(255,255,255,0.015)"
      stroke="rgba(103,216,232,0.35)"
      stroke-dasharray="6 8"
    ></rect>
    <text x="320" y="70" class="sd__mono sd__water">
      {labels.onDevice}
    </text>

    <!-- devices -->
    <g class="sd__devices">
      {[110, 170, 230, 290].map((y, i) => (
        <g>
          <rect x="40" y={y - 20} width="150" height="40" rx="12" fill="#0A1E27" stroke="rgba(255,255,255,0.14)" />
          <circle cx="62" cy={y} r="5" fill="#4EA8FF" />
          <rect x="76" y={y - 3} width={70 - i * 8} height="6" rx="3" fill="rgba(255,255,255,0.18)" />
        </g>
      ))}
      <text x="40" y="70" class="sd__mono">
        {labels.devices}
      </text>
    </g>

    <!-- lines in -->
    <path
      d="M190 110 C 260 110, 270 200, 360 200 M190 170 C 260 170, 280 200, 360 200 M190 230 C 260 230, 280 200, 360 200 M190 290 C 260 290, 270 200, 360 200"
      fill="none"
      stroke={`url(#${id}-in)`}
      stroke-width="2"
    ></path>

    <!-- DNS :53 -->
    <g>
      <rect x="360" y="170" width="120" height="60" rx="14" fill="#0E2731" stroke="#4EA8FF" stroke-opacity="0.6"></rect>
      <text x="420" y="198" text-anchor="middle" class="sd__label">
        {labels.dns}
      </text>
      <text x="420" y="218" text-anchor="middle" class="sd__mono sd__in">
        :53
      </text>
    </g>
    <path d="M480 200 H 540" stroke="#4EA8FF" stroke-width="2"></path>

    <!-- the sluice with the engine inside -->
    <circle cx="640" cy="200" r="150" fill={`url(#${id}-glow)`}></circle>
    <rect
      x="540"
      y="110"
      width="200"
      height="180"
      rx="22"
      fill="rgba(245,196,81,0.05)"
      stroke="#F5C451"
      stroke-width="2"
    ></rect>
    <path d="M640 128 V 272" stroke="#F5C451" stroke-width="5" stroke-linecap="round"></path>
    <text x="640" y="100" text-anchor="middle" class="sd__mono sd__gold">
      {labels.sluice}
    </text>
    <text x="640" y="316" text-anchor="middle" class="sd__label sd__small">
      {labels.engine}
    </text>

    <!-- stopped: ends at the gate -->
    <g>
      <path d="M560 236 H 628" stroke="#FF5A5A" stroke-width="2" stroke-dasharray="3 5"></path>
      <path d="M624 228 l 12 16 M636 228 l -12 16" stroke="#FF5A5A" stroke-width="2.5" stroke-linecap="round"></path>
      <text x="560" y="262" class="sd__mono sd__no">
        {labels.stopped}
      </text>
    </g>
    <!-- passed: goes on -->
    <path d="M560 172 H 740" stroke="#5CE39A" stroke-width="2"></path>

    <path d="M740 172 C 820 172, 840 200, 900 200" fill="none" stroke={`url(#${id}-out)`} stroke-width="2"></path>
    <text x="760" y="160" class="sd__mono sd__ok">
      {labels.passed}
    </text>

    <!-- internet -->
    <g>
      <circle cx="975" cy="200" r="70" fill="rgba(78,168,255,0.06)" stroke="rgba(103,216,232,0.4)"></circle>
      <ellipse cx="975" cy="200" rx="30" ry="70" fill="none" stroke="rgba(103,216,232,0.25)"></ellipse>
      <path d="M905 200 H 1045 M915 165 H 1035 M915 235 H 1035" stroke="rgba(103,216,232,0.2)"></path>
      <text x="975" y="300" text-anchor="middle" class="sd__label">
        {labels.internet}
      </text>
    </g>
  </svg>

  <!-- phone: the same flow, top to bottom -->
  <svg class="sd__svg sd__svg--tall" viewBox="0 0 360 720" role="img" aria-labelledby={`${id}-t2 ${id}-d2`}>
    <title id={`${id}-t2`}>{labels.title}</title>
    <desc id={`${id}-d2`}>{labels.desc}</desc>
    <text x="24" y="34" class="sd__mono">
      {labels.devices}
    </text>
    {[40, 120, 200, 280].map((x) => (
      <g>
        <rect x={x - 20} y="48" width="56" height="40" rx="12" fill="#0A1E27" stroke="rgba(255,255,255,0.14)" />
        <circle cx={x + 8} cy="68" r="5" fill="#4EA8FF" />
      </g>
    ))}
    <path
      d="M48 88 C 48 130, 180 120, 180 160 M128 88 C 128 130, 180 130, 180 160 M208 88 C 208 130, 180 130, 180 160 M288 88 C 288 130, 180 120, 180 160"
      fill="none"
      stroke="#4EA8FF"
      stroke-opacity="0.6"
      stroke-width="2"
    ></path>

    <rect
      x="16"
      y="140"
      width="328"
      height="420"
      rx="24"
      fill="rgba(255,255,255,0.015)"
      stroke="rgba(103,216,232,0.35)"
      stroke-dasharray="6 8"
    ></rect>
    <text x="32" y="548" class="sd__mono sd__water">
      {labels.onDevice}
    </text>

    <rect x="120" y="164" width="120" height="56" rx="14" fill="#0E2731" stroke="#4EA8FF" stroke-opacity="0.6"></rect>
    <text x="180" y="190" text-anchor="middle" class="sd__label">
      {labels.dns}
    </text>
    <text x="180" y="208" text-anchor="middle" class="sd__mono sd__in">
      :53
    </text>
    <path d="M180 220 V 260" stroke="#4EA8FF" stroke-width="2"></path>

    <rect
      x="70"
      y="260"
      width="220"
      height="200"
      rx="22"
      fill="rgba(245,196,81,0.05)"
      stroke="#F5C451"
      stroke-width="2"
    ></rect>
    <text x="180" y="250" text-anchor="middle" class="sd__mono sd__gold">
      {labels.sluice}
    </text>
    <path d="M90 360 H 270" stroke="#F5C451" stroke-width="5" stroke-linecap="round"></path>
    <path d="M120 280 V 346" stroke="#FF5A5A" stroke-width="2" stroke-dasharray="3 5"></path>
    <path d="M112 342 l 16 12 M128 342 l -16 12" stroke="#FF5A5A" stroke-width="2.5" stroke-linecap="round"></path>
    <text x="140" y="310" class="sd__mono sd__no">
      {labels.stopped}
    </text>
    <path d="M240 280 V 460" stroke="#5CE39A" stroke-width="2"></path>
    <text x="180" y="440" text-anchor="middle" class="sd__label sd__small">
      {labels.engine}
    </text>
    <path d="M240 460 V 600" stroke="#5CE39A" stroke-width="2"></path>
    <text x="252" y="590" class="sd__mono sd__ok">
      {labels.passed}
    </text>

    <circle cx="180" cy="660" r="46" fill="rgba(78,168,255,0.06)" stroke="rgba(103,216,232,0.4)"></circle>
    <ellipse cx="180" cy="660" rx="20" ry="46" fill="none" stroke="rgba(103,216,232,0.25)"></ellipse>
    <path d="M240 600 C 240 630, 220 640, 222 650" fill="none" stroke="#5CE39A" stroke-width="2"></path>
    <text x="180" y="716" text-anchor="middle" class="sd__label">
      {labels.internet}
    </text>
  </svg>
</figure>

<style>
  .sd {
    margin: 0;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: radial-gradient(60% 80% at 55% 50%, rgb(245 196 81 / 0.05), transparent 70%), var(--bg-deep);
  }
  .sd__svg {
    width: 100%;
    height: auto;
  }
  .sd__svg--tall {
    display: none;
    max-width: 380px;
    margin-inline: auto;
  }
  @media (max-width: 719px) {
    .sd__svg--wide {
      display: none;
    }
    .sd__svg--tall {
      display: block;
    }
  }
  .sd :global(.sd__label) {
    fill: var(--text);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 540;
  }
  .sd :global(.sd__small) {
    font-size: 13px;
    fill: var(--soft);
  }
  .sd :global(.sd__mono) {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sd :global(.sd__in) {
    fill: var(--in-ink);
  }
  .sd :global(.sd__gold) {
    fill: var(--gate-ink);
  }
  .sd :global(.sd__ok) {
    fill: var(--ok-ink);
  }
  .sd :global(.sd__no) {
    fill: var(--no-ink);
  }
  .sd :global(.sd__water) {
    fill: var(--water);
  }
</style>
