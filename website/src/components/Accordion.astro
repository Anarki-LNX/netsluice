---
import Icon from './Icon.astro';

// FAQ: native <details>, keyboard and screen reader friendly without JavaScript.
// Pass items with already-rendered HTML in `html` (Markdown from the faq collection,
// rendered by Astro) or plain `text`, or use the default slot with <details class="acc__item">.
export interface AccordionItem {
  id?: string | undefined;
  question: string;
  text?: string | undefined;
}
interface Props {
  items?: AccordionItem[] | undefined;
  name?: string | undefined;
}
const { items = [] } = Astro.props;
---

<div class="acc">
  {items.map((item) => (
    <details class="acc__item" id={item.id}>
      <summary class="acc__q">
        <span>{item.question}</span>
        <Icon name="chevron-down" size={18} class="acc__chev" />
      </summary>
      <div class="acc__a">
        <p>{item.text}</p>
      </div>
    </details>
  ))}
  <slot />
</div>

<style>
  .acc {
    border-top: 1px solid var(--line);
  }
  .acc :global(.acc__item) {
    border-bottom: 1px solid var(--line);
  }
  .acc :global(.acc__q) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.75rem;
    padding: var(--s-4) var(--s-1);
    color: var(--text);
    font-size: 1.0938rem;
    font-weight: 520;
    list-style: none;
    cursor: pointer;
  }
  .acc :global(.acc__q::-webkit-details-marker) {
    display: none;
  }
  .acc :global(.acc__q:hover) {
    color: var(--gate-ink);
  }
  .acc :global(.acc__chev) {
    flex: none;
    color: var(--muted);
    transition: transform var(--t-med) var(--ease-out);
  }
  .acc :global(details[open] .acc__chev) {
    transform: rotate(180deg);
    color: var(--gate);
  }
  .acc :global(.acc__a) {
    padding: 0 var(--s-1) var(--s-6);
    color: var(--soft);
    max-width: 44rem;
  }
  .acc :global(.acc__a > * + *) {
    margin-top: 0.8em;
  }
</style>
