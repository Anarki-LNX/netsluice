---
// The top of every inner page: mono label with number, serif h1, lead.
interface Props {
  num?: string | undefined;
  label?: string | undefined;
  title: string;
  lead?: string | undefined;
  /** tone of the soft light behind the title */
  tone?: 'water' | 'gate' | 'ok' | 'in' | undefined;
}
const { num, label, title, lead, tone = 'water' } = Astro.props;
---

<section class:list={['ph', `ph--${tone}`]}>
  <div class="container ph__inner">
    {(num || label) && (
      <p class="label ph__label">
        {num && <span class="num">{num}</span>}
        {num && label && <span aria-hidden="true"> · </span>}
        {label}
      </p>
    )}
    <h1 class="ph__title">{title}</h1>
    {lead && <p class="lead ph__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .ph {
    --tone: var(--water);
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .ph::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -40%;
    width: min(1100px, 140vw);
    height: 140%;
    transform: translateX(-30%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--tone) 10%, transparent), transparent);
    pointer-events: none;
  }
  .ph--gate {
    --tone: var(--gate);
  }
  .ph--ok {
    --tone: var(--ok);
  }
  .ph--in {
    --tone: var(--in);
  }
  .ph__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-5);
  }
  .ph__label {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .ph__label::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    margin-right: 0.65rem;
    background: linear-gradient(to right, transparent, var(--gate));
  }
  .ph__title {
    max-width: 18ch;
  }
  .ph__lead {
    max-width: 40rem;
  }
</style>
