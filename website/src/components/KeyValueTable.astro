---
// Label/value pairs (specs, measurements, LED meanings) as a definition list.
interface Props {
  rows: { label: string; value: string }[];
  /** column titles, shown as a quiet header row */
  columns?: { label: string; value: string } | undefined;
  mono?: boolean | undefined;
}
const { rows, columns, mono = false } = Astro.props;
---

<div class="kv" data-reveal>
  {columns && (
    <div class="kv__head" aria-hidden="true">
      <span>{columns.label}</span>
      <span>{columns.value}</span>
    </div>
  )}
  <dl class="kv__list">
    {rows.map((r) => (
      <div class="kv__row">
        <dt>{r.label}</dt>
        <dd class:list={{ kv__mono: mono }}>{r.value}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .kv {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: rgb(255 255 255 / 0.015);
    overflow: hidden;
  }
  .kv__head,
  .kv__row {
    display: grid;
    gap: var(--s-1) var(--s-6);
    padding: var(--s-4) var(--s-5);
  }
  .kv__head {
    border-bottom: 1px solid var(--line-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .kv__list {
    margin: 0;
  }
  .kv__row + .kv__row {
    border-top: 1px solid var(--line);
  }
  .kv__row dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .kv__row dd {
    margin: 0;
    color: var(--text);
  }
  .kv__mono {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }
  @media (min-width: 640px) {
    .kv__head,
    .kv__row {
      grid-template-columns: minmax(9rem, 14rem) 1fr;
    }
    .kv__head span:first-child {
      display: block;
    }
  }
  @media (max-width: 639px) {
    .kv__head {
      display: none;
    }
  }
</style>
