---
import { getCollection, render } from 'astro:content';
import DocsLayout from '~/layouts/DocsLayout.astro';
import { entrySlug } from '~/content.config';
import type { Locale } from '~/i18n';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { lang: entry.data.lang, slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const locale = Astro.params.lang as Locale;
const { Content, headings } = await render(entry);
const slug = entrySlug(entry.id);
---

<DocsLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  slug={slug}
  headings={headings}
  updated={entry.data.updated}
  sourcePath={`website/src/content/docs/${locale}/${slug}.md`}
>
  <Content />
</DocsLayout>
