---
import PageLayout from '~/layouts/PageLayout.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import Steps from '~/components/Steps.astro';
import Step from '~/components/Step.astro';
import CodeBlock from '~/components/CodeBlock.astro';
import Callout from '~/components/Callout.astro';
import KeyValueTable from '~/components/KeyValueTable.astro';
import CtaButton from '~/components/CtaButton.astro';
import Button from '~/components/Button.astro';
import { maybeCopy } from '~/i18n/copy';
import { localeStaticPaths, t, localizePath, routes, type Locale } from '~/i18n';

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const tr = t(locale);
const copy = maybeCopy(locale);
const c = copy?.gettingStarted;
const meta = copy?.meta.gettingStarted;
// the two warnings that can cost data are shown as "danger"
const dangerIdx = new Set([1, 2]);
---

<PageLayout
  locale={locale}
  title={meta?.title ?? tr('nav.gettingStarted')}
  heading={c?.title}
  description={meta?.description ?? tr('nav.gettingStarted')}
  lead={c?.intro}
  num="GS"
  label={tr('nav.gettingStarted')}
  tone="ok"
>
  <Fragment slot="hero">
    <div class="gs__hero">
      <Button href={localizePath(routes.downloads, locale)} variant="primary" icon="download">
        {tr('nav.downloads')}
      </Button>
    </div>
  </Fragment>
  {!c ? (
    <section class="section section--tight">
      <div class="container">
        {/* TODO(copy) */}
        <Callout locale={locale}>
          <p>{tr('common.todo')}</p>
        </Callout>
      </div>
    </section>
  ) : (
    <>
      <section class="section section--tight">
        <div class="container gs__top">
          <div>
            <SectionHeader num="01" label="microSD" title={c.prerequisites.title} />
            <ul role="list" class="gs__need">
              {c.prerequisites.items.map((it) => (
                <li data-reveal>{it}</li>
              ))}
            </ul>
          </div>
          <aside class="gs__warn" aria-labelledby="gs-warn">
            <h2 id="gs-warn" class="gs__warntitle">
              {c.warnings.title}
            </h2>
            {c.warnings.items.map((w, i) => (
              <Callout locale={locale} type={dangerIdx.has(i) ? 'danger' : 'warn'} title={w.title}>
                <p>{w.text}</p>
              </Callout>
            ))}
          </aside>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <SectionHeader num="02" label="10 × " title={c.steps.title} />
          <div class="gs__steps">
            <Steps>
              {c.steps.items.map((s, i) => (
                <Step num={i + 1} title={s.title} text={s.text}>
                  {s.code && <CodeBlock code={s.code} locale={locale} lang="shell" />}
                </Step>
              ))}
            </Steps>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container gs__two">
          <div>
            <SectionHeader num="03" label="LED" title={c.leds.title} />
            <KeyValueTable rows={c.leds.rows} columns={{ label: c.leds.columns.led, value: c.leds.columns.meaning }} />
            <p class="gs__note">{c.leds.normal}</p>
          </div>
          <div>
            <SectionHeader num="04" label={tr('docs.next')} title={c.after.title} />
            <ol role="list" class="gs__after">
              {c.after.items.map((it, i) => (
                <li data-reveal>
                  <span class="label">
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  </span>
                  <span>{it}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container gs__two">
          <div class="gs__box" data-reveal>
            <h2 class="gs__boxtitle">{c.buildYourself.title}</h2>
            <p>{c.buildYourself.text}</p>
            <CtaButton cta={c.buildYourself.cta} locale={locale} />
          </div>
          <div class="gs__box" data-reveal>
            <h2 class="gs__boxtitle">{c.help.title}</h2>
            <p>{c.help.text}</p>
            <CtaButton cta={c.help.cta} locale={locale} />
          </div>
        </div>
      </section>
    </>
  )}
</PageLayout>

<style>
  .gs__hero {
    margin-top: var(--s-2);
  }
  .gs__top,
  .gs__two {
    display: grid;
    gap: var(--s-12);
  }
  @media (min-width: 1080px) {
    .gs__top {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
    .gs__two {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .gs__need {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .gs__need li {
    position: relative;
    padding: var(--s-4) 0 var(--s-4) var(--s-8);
    border-bottom: 1px solid var(--line);
    color: var(--soft);
  }
  .gs__need li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 1.45rem;
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--ok);
    border-radius: 2px;
  }
  .gs__warn {
    display: grid;
    gap: var(--s-3);
  }
  .gs__warntitle,
  .gs__boxtitle {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    margin-bottom: var(--s-2);
  }
  .gs__steps {
    max-width: 50rem;
  }
  .gs__note {
    margin-top: var(--s-4);
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .gs__after {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .gs__after li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-3);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--line);
    color: var(--soft);
  }
  .gs__box {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--panel);
    color: var(--soft);
  }
</style>
