---
import PageLayout from '~/layouts/PageLayout.astro';
import ReleaseHistory from '~/components/ReleaseHistory.astro';
import Button from '~/components/Button.astro';
import { getReleaseData } from '~/lib/releases';
import { REPO } from '~/config/site';
import { maybeCopy } from '~/i18n/copy';
import { localeStaticPaths, t, formatDate, type Locale } from '~/i18n';

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.lang as Locale;
const tr = t(locale);
const data = await getReleaseData();
const copy = maybeCopy(locale);
const c = copy?.changelog;
const meta = copy?.meta.changelog;
const description =
  (meta?.description ?? locale === 'de')
    ? 'Alle Versionen von NetSluice mit ihren Hinweisen, die neueste zuerst.'
    : 'Every version of NetSluice with its notes, newest first.';
---

<PageLayout
  locale={locale}
  title={meta?.title ?? tr('nav.changelog')}
  heading={c?.title}
  description={description}
  lead={c?.intro}
  num="Δ"
  label={tr('release.history')}
  version={data.latest?.version}
  versionUrl={data.latest?.htmlUrl}
>
  <section class="section section--tight">
    <div class="container container--narrow cl">
      {c && <p class="cl__lang">{c.notesLanguage}</p>}
      {data.releases.length > 0 ? (
        <ReleaseHistory locale={locale} releases={data.releases} />
      ) : (
        <p class="muted">{c?.empty ?? tr('release.unavailable')}</p>
      )}
      {data.source === 'cache' && data.fetchedAt && (
        <p class="cl__stale">
          {tr('release.stale')} <time datetime={data.fetchedAt}>{formatDate(data.fetchedAt, locale)}</time>
        </p>
      )}
      <Button href={REPO.releases} external newTabText={tr('a11y.newTab')}>
        {tr('cta.allReleases')}
      </Button>
    </div>
  </section>
</PageLayout>

<style>
  .cl {
    display: grid;
    gap: var(--s-8);
    justify-items: start;
  }
  .cl > :global(ol) {
    width: 100%;
  }
  .cl__lang {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .cl__stale {
    color: var(--faint);
    font-size: 0.875rem;
  }
</style>
