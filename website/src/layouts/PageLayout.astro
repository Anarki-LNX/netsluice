---
import Base from './Base.astro';
import PageHero from '~/components/PageHero.astro';
import DonateBlock from '~/components/DonateBlock.astro';
import type { Locale } from '~/i18n';

// An inner page: hero (h1), content, support block.
interface Props {
  locale: Locale;
  title: string;
  /** h1 if different from the <title> */
  heading?: string | undefined;
  description: string;
  lead?: string | undefined;
  num?: string | undefined;
  label?: string | undefined;
  tone?: 'water' | 'gate' | 'ok' | 'in' | undefined;
  version?: string | undefined;
  versionUrl?: string | undefined;
  donate?: boolean | undefined;
}
const { locale, title, heading, description, lead, num, label, tone, version, versionUrl, donate = true } = Astro.props;
---

<Base locale={locale} title={title} description={description} version={version} versionUrl={versionUrl}>
  <PageHero num={num} label={label} title={heading ?? title} lead={lead ?? description} tone={tone}>
    <slot name="hero" />
  </PageHero>
  <slot />
  {donate && <DonateBlock locale={locale} />}
</Base>
